# Copy to .env.local. Everything prefixed VITE_ is bundled into the browser
# build — never put private keys, seed phrases or secret API keys here.

# devnet | testnet | mainnet-beta  (defaults to devnet; verified at runtime by genesis hash)
VITE_SOLANA_NETWORK=devnet

# Optional custom RPC (the free public Devnet RPC is rate-limited; a Helius/QuickNode
# devnet URL with a client-side key is smoother for demos)
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# StratX auction program id (public key). Set after `anchor deploy` — see docs/AUCTION.md.
# VITE_AUCTION_PROGRAM_ID=

# Google / Apple / email sign-in. Create a free app at https://dashboard.privy.io,
# enable Google, Apple and Email, add http://localhost:5173 to Allowed origins,
# then paste the App ID here (it's public, not a secret). Wallet sign-in works without it.
# VITE_PRIVY_APP_ID=
